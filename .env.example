PORT=8080

# Set your display location.
LATITUDE=30.2741
LONGITUDE=120.1551
LOCATION_NAME=杭州市西湖区
TIMEZONE=Asia/Shanghai
WEATHER_API_URL=http://api.open-meteo.com/v1/forecast
AIR_QUALITY_API_URL=http://air-quality-api.open-meteo.com/v1/air-quality

# metric or imperial
UNITS=metric

# Kindle browser refresh interval and server-side weather cache.
PAGE_REFRESH_SECONDS=60
WEATHER_CACHE_SECONDS=900
REQUEST_TIMEOUT_SECONDS=10

# Old "The New Kindle" / Kindle Basic is usually 600x800.
# The browser header eats vertical space, so 700 is a safer default.
KINDLE_WIDTH=600
KINDLE_HEIGHT=700
FORECAST_DAYS=3
